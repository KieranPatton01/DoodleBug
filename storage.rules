rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Doodlebug dropped photo stickers
    match /doodle_photos/{photoId} {
      // Anyone can fetch photos by ID (direct GET via URL) referenced by published pages,
      // but listing/enumerating the bucket contents is forbidden to prevent scraping unpublished photos.
      allow get: if true;
      allow list: if false;

      // Only the authorized site owner UID can upload photos
      // Enforces safe raster image content-type (SVG dropped to prevent script/XSS injection)
      // and maximum file size of 5MB.
      // NOTE: Replace YOUR_ALLOWED_FIREBASE_UID_HERE with your actual Firebase User UID before deploying:
      // firebase deploy --only storage
      allow create: if request.auth != null
                    && request.auth.uid == 'YOUR_ALLOWED_FIREBASE_UID_HERE'
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null
                    && request.auth.uid == 'YOUR_ALLOWED_FIREBASE_UID_HERE';
    }
  }
}
